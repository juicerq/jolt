{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["bun", "node"],
    "allowImportingTsExtensions": false,
    "paths": {
      "@src/*": ["./src/*"],
      "@drizzle/*": ["./drizzle/*"]
    }
  },
  "include": ["src", "tests", "electron.vite.config.ts", "vite.prototype.config.ts"]
}
