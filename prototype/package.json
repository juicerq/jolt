{
  "name": "harness-bun-engine-prototype",
  "private": true,
  "version": "0.0.0-prototype",
  "type": "module",
  "main": "out/main/index.js",
  "trustedDependencies": ["electron"],
  "scripts": {
    "postinstall": "bun node_modules/electron/install.js",
    "dev": "electron-vite dev",
    "dev:compiled": "PROTOTYPE_ENGINE_MODE=compiled electron-vite dev",
    "build": "bun run build:engine && electron-vite build",
    "build:engine": "bun build --compile --outfile dist-engine/harness-prototype-engine src/engine/index.ts",
    "check": "tsc --noEmit",
    "engine": "bun src/engine/index.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.251",
    "@orpc/client": "1.15.0",
    "@orpc/contract": "1.15.0",
    "@orpc/server": "1.15.0",
    "@orpc/tanstack-query": "1.15.0",
    "@tanstack/react-query": "5.102.8",
    "arktype": "2.2.3",
    "drizzle-orm": "0.45.2",
    "react": "19.2.5",
    "react-dom": "19.2.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4",
    "@types/bun": "1.4.0",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "drizzle-kit": "0.31.10",
    "electron": "44.0.0",
    "electron-vite": "5.0.0",
    "tailwindcss": "^4",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  }
}
