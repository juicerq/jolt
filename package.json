{
  "name": "jolt",
  "version": "0.0.0",
  "private": true,
  "packageManager": "bun@1.4.0",
  "type": "module",
  "main": "out/main/index.js",
  "trustedDependencies": ["electron"],
  "scripts": {
    "postinstall": "bun node_modules/electron/install.js",
    "dev": "bun run build:engine && electron-vite dev",
    "dev:load": "JOLT_USER_DATA=$PWD/.jolt-load JOLT_LOAD_PROVIDER=true bun run dev",
    "seed:load": "bun src/engine/persistence/load-seed.ts",
    "bench:open": "bun bench/conversation-open.ts",
    "bench:turn": "bun bench/conversation-turn.ts",
    "bench:boot": "bun bench/boot.ts",
    "bench:typing": "bun bench/typing.ts",
    "bench:scroll": "bun bench/scroll.ts",
    "bench:memory": "bun bench/memory.ts",
    "bench:queue": "bun bench/queue.ts",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "test": "bun run build:engine && bun test tests --no-orphans --parallel=4",
    "test:stress": "bun run build:engine && bun test tests --no-orphans --parallel=4 --randomize --rerun-each=3",
    "typecheck": "tsc --noEmit",
    "build:engine": "bun build --compile --outfile dist-engine/jolt-engine src/engine/index.ts",
    "build:electron": "electron-vite build",
    "build": "bun run build:engine && bun run build:electron"
  },
  "dependencies": {
    "@blobatar/react": "^2.7.0",
    "@earendil-works/pi-coding-agent": "0.84.4",
    "@heroicons/react": "^2.2.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@orpc/client": "1.15.0",
    "@orpc/contract": "1.15.0",
    "@orpc/server": "1.15.0",
    "@orpc/tanstack-query": "1.15.0",
    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-store": "0.11.1",
    "baileys": "^7.0.0-rc14",
    "blobatar": "^2.7.0",
    "drizzle-orm": "1.0.0-rc.4",
    "hast-util-to-jsx-runtime": "2.3.6",
    "highlight.js": "10.7.3",
    "qrcode.react": "^4.2.0",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "remark-gfm": "^4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4",
    "@types/bun": "1.4.0",
    "@types/hast": "3.0.5",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "drizzle-kit": "1.0.0-rc.4",
    "electron": "44.0.0",
    "electron-vite": "5.0.0",
    "tailwindcss": "^4",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  }
}
