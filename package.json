{
  "name": "bot-teams",
  "version": "0.0.0",
  "private": true,
  "packageManager": "bun@1.4.0",
  "type": "module",
  "main": "out/main/index.js",
  "trustedDependencies": ["electron"],
  "scripts": {
    "postinstall": "bun node_modules/electron/install.js",
    "dev": "bun run build:engine && electron-vite dev",
    "test": "bun run build:engine && bun test",
    "typecheck": "tsc --noEmit",
    "build:engine": "bun build --compile --outfile dist-engine/bot-teams-engine src/engine/index.ts",
    "build:electron": "electron-vite build",
    "build": "bun run build:engine && bun run build:electron"
  },
  "dependencies": {
    "@orpc/client": "1.15.0",
    "@orpc/contract": "1.15.0",
    "@orpc/server": "1.15.0",
    "@orpc/tanstack-query": "1.15.0",
    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-store": "0.11.1",
    "arktype": "2.2.3",
    "drizzle-orm": "0.45.2",
    "react": "19.2.5",
    "react-dom": "19.2.5"
  },
  "devDependencies": {
    "@types/bun": "1.4.0",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "drizzle-kit": "0.31.10",
    "electron": "44.0.0",
    "electron-vite": "5.0.0",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  }
}
